// Pando's docs (site/docs): an assets-only Worker, no code. Every request is a
// static file from dist/ (npm run check builds it and checks its links);
// a path with no file gets the site's 404 page. pando-ops deploys it.
// docs.gitpando.com, a Custom Domain (wrangler deploy makes its DNS record and
// certificate); its workers.dev address stays on through the switch.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pando-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "docs.gitpando.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
