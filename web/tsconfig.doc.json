// The two modules that import @plannotator/ui (src/ui/doc/PlannotatorDoc.tsx
// and src/ui/doc/PlannotatorTree.tsx).
// The package ships TypeScript sources, which TypeScript checks under the
// importing project's options; they are written without
// noUncheckedIndexedAccess, so this check leaves it off. Everything else in
// web/ is checked by tsconfig.json with it on.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noUncheckedIndexedAccess": false },
  "include": ["src/ui/doc/PlannotatorDoc.tsx", "src/ui/doc/PlannotatorTree.tsx"],
  "exclude": []
}
