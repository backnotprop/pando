// The modules that import @plannotator/ui: src/ui/doc/PlannotatorDoc.tsx,
// src/ui/doc/PlannotatorTree.tsx, src/ui/doc/setup.ts (its one configure
// call), src/ui/doc/artifact/ (an artifact under review) and src/ui/doc/guide.ts
// (a guided review's snapshot, read with @plannotator/core).
// The package ships TypeScript sources, which TypeScript checks under the
// importing project's options; they are written without
// noUncheckedIndexedAccess, so this check leaves it off. Everything else in
// web/ is checked by tsconfig.json with it on.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noUncheckedIndexedAccess": false },
  "include": ["src/ui/doc/PlannotatorDoc.tsx", "src/ui/doc/PlannotatorTree.tsx", "src/ui/doc/setup.ts", "src/ui/doc/artifact", "src/ui/doc/guide.ts"],
  "exclude": []
}
