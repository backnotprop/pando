{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"],
  // Checked by tsconfig.doc.json: they import @plannotator/ui, whose sources
  // TypeScript would check under this file's noUncheckedIndexedAccess.
  "exclude": ["src/ui/doc/PlannotatorDoc.tsx", "src/ui/doc/PlannotatorTree.tsx", "src/ui/doc/setup.ts", "src/ui/doc/artifact"]
}
