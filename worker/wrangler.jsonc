// The Pando Worker. Development deploys as pando-dev on the owner's account.
// Pando keeps to its own resources: Workers named pando-*, the Artifacts
// namespace pando-dev, R2 buckets named pando-*, and never anything named
// workspaces-*.
//
// Secrets (the owner types them; never in this file):
//   npx wrangler secret put PANDO_BOOTSTRAP      the first admin credential
//   npx wrangler secret put BUILDKITE_API_TOKEN  for buildkite hooks (M5)
//   npx wrangler secret put WORKOS_API_KEY       the WorkOS environment "Pando"
// Local dev reads them from worker/.dev.vars (gitignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pando-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // The WorkOS environment "Pando" (public in a device flow). A secret of
    // the same name, if set, takes its place.
    "WORKOS_CLIENT_ID": "client_01M3ZW5WYKNDQZE358DYA7VHY5"
  },
  "observability": { "enabled": true },
  "artifacts": [
    // remote: wrangler dev talks to the real Artifacts service.
    { "binding": "ARTIFACTS", "namespace": "pando-dev", "remote": true }
  ],
  "r2_buckets": [
    // For the live lane's large files (M7).
    { "binding": "BLOBS", "bucket_name": "pando-dev-blobs" }
  ],
  // Branch facts (ahead, behind, mergeable) computed on change: a sweep per new
  // main head, a job per pushed branch. The consumer is this Worker's queue().
  "queues": {
    "producers": [
      { "binding": "BRANCH_FACTS", "queue": "pando-branch-facts" },
      // Hook deliveries (C9): message = {monorepo, delivery_id}; the row is in the monorepo object.
      { "binding": "HOOKS", "queue": "pando-hooks" }
    ],
    "consumers": [
      {
        "queue": "pando-hooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        // 1 try and 4 retries (10 s, 60 s, 5 min, 30 min), then the dead-letter queue.
        "max_retries": 4,
        "max_concurrency": 10,
        "dead_letter_queue": "pando-hooks-dlq"
      },
      { "queue": "pando-hooks-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 },
      {
        "queue": "pando-branch-facts",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5,
        "dead_letter_queue": "pando-branch-facts-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MONOREPO", "class_name": "MonorepoObject" },
      { "name": "META", "class_name": "MetaLayerObject" },
      // Users, credentials and membership: one instance for the whole Worker.
      { "name": "ACCOUNTS", "class_name": "AccountsObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MonorepoObject", "MetaLayerObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountsObject"] }
  ],
  // The contract, served at /v1/openapi.yaml.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }]
}
