// The Pando Worker. Development deploys as pando-dev on the owner's account.
// Pando keeps to its own resources: Workers named pando-*, the Artifacts
// namespace pando-dev, R2 buckets named pando-*, and never anything named
// workspaces-*.
//
// Secrets (the owner types them; never in this file):
//   npx wrangler secret put PANDO_BOOTSTRAP      the first admin credential
//   npx wrangler secret put BUILDKITE_API_TOKEN  for buildkite hooks (M5)
//   npx wrangler secret put WORKOS_API_KEY       the WorkOS environment "Pando"
// Local dev reads them from worker/.dev.vars (gitignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pando-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // The WorkOS environment "Pando" (public in a device flow). A secret of
    // the same name, if set, takes its place.
    "WORKOS_CLIENT_ID": "client_01M3ZW5WYKNDQZE358DYA7VHY5"
  },
  "observability": { "enabled": true },
  "artifacts": [
    // remote: wrangler dev talks to the real Artifacts service.
    { "binding": "ARTIFACTS", "namespace": "pando-dev", "remote": true }
  ],
  "r2_buckets": [
    // For the live lane's large files (M7).
    { "binding": "BLOBS", "bucket_name": "pando-dev-blobs" },
    // The file pages' computed answers (FILES.md): last commits per folder, a
    // path's history pages, walk checkpoints. A 90-day lifecycle rule ends them.
    { "binding": "CACHE", "bucket_name": "pando-dev-cache" }
  ],
  // Workers Caching (FILES.md, the spike's shape A): only the Objects
  // entrypoint (git objects by hash, the repo in every key) is cached; the
  // default entrypoint never is, whatever a handler's Cache-Control says.
  "cache": { "enabled": true, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Objects": { "type": "worker", "cache": { "enabled": true } },
    // The feed's drain (RPC only, which is never cached); listed off so it stays so.
    "FeedDrain": { "type": "worker", "cache": { "enabled": false } }
  },
  // Branch facts (ahead, behind, mergeable) computed on change: a sweep per new
  // main head, a job per pushed branch. The consumer is this Worker's queue().
  "queues": {
    "producers": [
      { "binding": "BRANCH_FACTS", "queue": "pando-branch-facts" },
      // Hook deliveries (C9): message = {monorepo, delivery_id}; the row is in the monorepo object.
      { "binding": "HOOKS", "queue": "pando-hooks" },
      // The home's activity feed (C25): membership changes. Lines and summaries drain by RPC (FeedDrain); kept until that is measured on pando-dev.
      { "binding": "FEED_QUEUE", "queue": "pando-feed" },
      // The file pages (FILES.md): a folder's last commits finished off the request.
      { "binding": "HISTORY_QUEUE", "queue": "pando-history" }
    ],
    "consumers": [
      {
        "queue": "pando-hooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        // 1 try and 4 retries (10 s, 60 s, 5 min, 30 min), then the dead-letter queue.
        "max_retries": 4,
        "max_concurrency": 10,
        "dead_letter_queue": "pando-hooks-dlq"
      },
      { "queue": "pando-hooks-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 },
      {
        "queue": "pando-branch-facts",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5,
        "dead_letter_queue": "pando-branch-facts-dlq"
      },
      {
        "queue": "pando-feed",
        "max_batch_size": 100,
        // No wait: a line reaches the home one hop sooner (pando-ops ruling, 2026-10-03; about $4.56 a month at 1,000 agents).
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 10,
        "dead_letter_queue": "pando-feed-dlq"
      },
      {
        "queue": "pando-history",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5,
        "dead_letter_queue": "pando-history-dlq"
      }
    ]
  },
  // Accounts (C8): users, credentials, monorepos, members, invites. The
  // primary is in ENAM; the owner turns on read replication in the dashboard
  // (D1 > pando-accounts-dev > Settings > Enable Read Replication).
  // Schema: worker/migrations; apply with
  //   npx wrangler d1 migrations apply pando-accounts-dev --local | --remote
  "d1_databases": [
    { "binding": "ACCOUNTS_DB", "database_name": "pando-accounts-dev", "database_id": "94185f0e-92b8-427f-ab29-c080cd79ad10", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MONOREPO", "class_name": "MonorepoObject" },
      { "name": "META", "class_name": "MetaLayerObject" },
      // Where accounts lived before D1 (C8); kept for the one-time copy, goes after launch.
      { "name": "ACCOUNTS", "class_name": "AccountsObject" },
      // One per person: the home's activity feed (C25).
      { "name": "FEED", "class_name": "FeedObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MonorepoObject", "MetaLayerObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountsObject"] },
    { "tag": "v3", "new_sqlite_classes": ["FeedObject"] }
  ],
  // The contract, served at /v1/openapi.yaml.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }]
}
